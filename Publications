  <style>
    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: #f1efe8;
      color: #171717;
      font-family: Arial, Helvetica, sans-serif;
    }

    a {
      color: inherit;
    }

    .container {
      width: min(1180px, calc(100% - 48px));
      margin: 0 auto;
    }

    /* HEADER */

    header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: rgba(241, 239, 232, 0.94);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid #171717;
    }

    nav {
      min-height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
    }

    .logo {
      font-size: 15px;
      font-weight: 700;
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .nav-links {
      display: flex;
      flex-wrap: wrap;
      gap: 24px;
    }

    .nav-links a {
      font-size: 14px;
      text-decoration: none;
    }

    .nav-links a:hover,
    .nav-links .active {
      text-decoration: underline;
      text-underline-offset: 5px;
    }

    /* PAGE HEADER */

    .page-header {
      padding: 110px 0 75px;
      border-bottom: 1px solid #171717;
    }

    .kicker {
      margin-bottom: 25px;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }

    h1 {
      max-width: 1050px;
      margin: 0;
      font-size: clamp(64px, 11vw, 145px);
      line-height: 0.86;
      letter-spacing: -0.065em;
      font-weight: 700;
    }

    .page-intro {
      max-width: 850px;
      margin-top: 55px;
      font-size: clamp(22px, 3vw, 34px);
      line-height: 1.25;
      letter-spacing: -0.02em;
    }

    /* PUBLICATION SECTIONS */

    section {
      padding: 85px 0;
      border-bottom: 1px solid #171717;
    }

    .publication-section {
      display: grid;
      grid-template-columns: 1fr 3fr;
      gap: 70px;
    }

    .publication-source {
      margin: 0;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }

    .source-info {
      margin-top: 16px;
      max-width: 180px;
      font-size: 13px;
      line-height: 1.5;
    }

    .source-info a {
      text-underline-offset: 4px;
    }

    .publication-list {
      border-top: 1px solid #171717;
    }

    .publication {
      display: grid;
      grid-template-columns: 125px 1fr;
      gap: 30px;
      padding: 27px 0 30px;
      border-bottom: 1px solid #999;
    }

    .publication-meta {
      padding-top: 4px;
      font-size: 13px;
      line-height: 1.5;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .publication-title {
      margin: 0;
      font-size: 26px;
      line-height: 1.15;
      letter-spacing: -0.025em;
      font-weight: 500;
    }

    .publication-title a {
      text-decoration: none;
    }

    .publication-title a:hover {
      text-decoration: underline;
      text-underline-offset: 6px;
    }

    .publication-description {
      margin-top: 10px;
      max-width: 680px;
      font-size: 16px;
      line-height: 1.5;
      color: #444;
    }

    .arrow {
      white-space: nowrap;
    }

    /* FOOTER */

    footer {
      padding: 32px 0 45px;
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      gap: 30px;
      font-size: 13px;
    }

    /* MOBILE */

    @media (max-width: 760px) {

      .container {
        width: min(100% - 30px, 1180px);
      }

      nav {
        align-items: flex-start;
        flex-direction: column;
        padding: 18px 0;
      }

      .nav-links {
        gap: 12px 18px;
      }

      .page-header {
        padding: 80px 0 55px;
      }

      section {
        padding: 60px 0;
      }

      .publication-section {
        grid-template-columns: 1fr;
        gap: 30px;
      }

      .source-info {
        max-width: none;
      }

      .publication {
        grid-template-columns: 1fr;
        gap: 8px;
      }

      .publication-title {
        font-size: 22px;
      }

      .footer-inner {
        flex-direction: column;
      }
    }
  </style>
</head>

